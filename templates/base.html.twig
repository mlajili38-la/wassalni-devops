<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        {% block title %}
            Wassalni - Covoiturage en Tunisie
        {% endblock %}
    </title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        :root{
            --primary:#6d28d9;
            --primary-dark:#4c1d95;
            --secondary:#8b5cf6;
            --dark:#0f172a;
            --dark-2:#1e293b;
            --light:#f8fafc;
            --border:#e2e8f0;
            --text:#334155;
            --white:#ffffff;
            --gold:#facc15;
        }

        body{
            font-family:'Inter',sans-serif;
            background:var(--light);
            color:var(--text);
            overflow-x:hidden;
        }

        /* ===================================================
                           NAVBAR
        =================================================== */

        .navbar{
            position:sticky;
            top:0;
            z-index:9999;

            background:
                linear-gradient(
                    135deg,
                    #0f172a 0%,
                    #1e1b4b 45%,
                    #4c1d95 100%
                );

            backdrop-filter:blur(20px);

            border-bottom:1px solid rgba(255,255,255,0.08);

            box-shadow:
                0 10px 30px rgba(0,0,0,0.08);
        }

        .nav-container{
            max-width:1600px;
            margin:auto;

            min-height:82px;

            display:flex;
            align-items:center;
            justify-content:space-between;

            gap:25px;

            padding:0 25px;
        }

        /* ===================================================
                           LOGO
        =================================================== */

        .logo{
            flex-shrink:0;
        }

        .logo a{
            text-decoration:none;

            display:flex;
            align-items:center;
            gap:12px;

            font-size:30px;
            font-weight:900;
            letter-spacing:-1px;

            color:white;
        }

        .logo-icon{
            width:50px;
            height:50px;

            border-radius:16px;

            background:
                linear-gradient(
                    135deg,
                    #facc15,
                    #fde047
                );

            display:flex;
            align-items:center;
            justify-content:center;

            box-shadow:
                0 10px 20px rgba(250,204,21,0.3);
        }

        .logo-icon i{
            color:#4c1d95;
            font-size:24px;
        }

        .logo-text{
            display:flex;
            flex-direction:column;
            line-height:1;
        }

        .logo-text strong{
            color:white;
            font-size:28px;
        }

        .logo-text span{
            font-size:11px;
            color:#c4b5fd;
            letter-spacing:2px;
            margin-top:4px;
        }

        /* ===================================================
                        NAVIGATION LINKS
        =================================================== */

        .nav-links{
            flex:1;

            display:flex;
            align-items:center;
            justify-content:center;

            gap:10px;

            min-width:0;

            overflow-x:auto;
            overflow-y:hidden;

            scrollbar-width:none;

            padding:8px 5px;
        }

        .nav-links::-webkit-scrollbar{
            display:none;
        }

        /* IMPORTANT :
           TOUS LES TABS SERONT VISIBLES */
        .nav-links a{
            flex-shrink:0;

            display:flex;
            align-items:center;
            gap:10px;

            padding:12px 18px;

            border-radius:18px;

            text-decoration:none;

            color:#e2e8f0;

            font-size:14px;
            font-weight:600;

            transition:0.3s ease;

            white-space:nowrap;

            position:relative;
        }

        .nav-links a i{
            font-size:15px;
        }

        .nav-links a:hover{
            background:rgba(255,255,255,0.12);

            color:white;

            transform:translateY(-2px);
        }

        .nav-links a.active{
            background:
                linear-gradient(
                    135deg,
                    rgba(255,255,255,0.18),
                    rgba(255,255,255,0.08)
                );

            color:#fff;

            box-shadow:
                0 10px 20px rgba(0,0,0,0.15);
        }

        /* ===================================================
                         USER MENU
        =================================================== */

        .user-menu{
            flex-shrink:0;

            display:flex;
            align-items:center;
            gap:15px;
        }

        .btn-login{
            display:flex;
            align-items:center;
            gap:10px;

            text-decoration:none;

            padding:12px 24px;

            border-radius:50px;

            color:white;
            font-weight:700;

            background:
                linear-gradient(
                    135deg,
                    #8b5cf6,
                    #6d28d9
                );

            transition:0.3s ease;
        }

        .btn-login:hover{
            transform:translateY(-3px);

            box-shadow:
                0 15px 25px rgba(109,40,217,0.35);
        }

        /* ===================================================
                      USER PROFILE
        =================================================== */

        .dropdown{
            position:relative;
        }

        .user-info{
            display:flex;
            align-items:center;
            gap:14px;

            padding:10px 18px;

            border-radius:60px;

            background:rgba(255,255,255,0.1);

            border:1px solid rgba(255,255,255,0.12);

            cursor:pointer;

            transition:0.3s ease;
        }

        .user-info:hover{
            background:rgba(255,255,255,0.18);
        }

        .user-avatar{
            width:42px;
            height:42px;

            border-radius:50%;

            background:
                linear-gradient(
                    135deg,
                    #facc15,
                    #fde047
                );

            display:flex;
            align-items:center;
            justify-content:center;

            flex-shrink:0;
        }

        .user-avatar i{
            color:#4c1d95;
            font-size:18px;
        }

        .user-details{
            display:flex;
            flex-direction:column;
            line-height:1.2;
        }

        .user-details strong{
            color:white;
            font-size:14px;
            font-weight:700;
        }

        .user-details span{
            color:#cbd5e1;
            font-size:12px;
        }

        /* ===================================================
                        DROPDOWN MENU
        =================================================== */

        .dropdown-menu{
            position:absolute;

            top:72px;
            right:0;

            width:280px;

            background:white;

            border-radius:24px;

            overflow:hidden;

            opacity:0;
            visibility:hidden;
            transform:translateY(15px);

            transition:0.3s ease;

            box-shadow:
                0 20px 40px rgba(0,0,0,0.12);

            z-index:9999;
        }

        .dropdown:hover .dropdown-menu{
            opacity:1;
            visibility:visible;
            transform:translateY(0);
        }

        .dropdown-header{
            padding:22px;

            background:
                linear-gradient(
                    135deg,
                    #6d28d9,
                    #4c1d95
                );

            color:white;
        }

        .dropdown-header h4{
            font-size:16px;
            margin-bottom:5px;
        }

        .dropdown-header p{
            font-size:13px;
            opacity:0.9;
        }

        .dropdown-menu a{
            display:flex;
            align-items:center;
            gap:14px;

            padding:15px 22px;

            text-decoration:none;

            color:#1e293b;

            font-weight:600;
            font-size:14px;

            border-bottom:1px solid #f1f5f9;

            transition:0.25s ease;
        }

        .dropdown-menu a:last-child{
            border-bottom:none;
        }

        .dropdown-menu a i{
            width:18px;
            color:#6d28d9;
        }

        .dropdown-menu a:hover{
            background:#f8fafc;
            padding-left:30px;
        }

        .dropdown-menu .logout{
            color:#dc2626;
        }

        .dropdown-menu .logout i{
            color:#dc2626;
        }

        .dropdown-menu .logout:hover{
            background:#fef2f2;
        }

        /* ===================================================
                         MOBILE BUTTON
        =================================================== */

        .mobile-menu-btn{
            display:none;

            width:46px;
            height:46px;

            border:none;

            border-radius:14px;

            background:rgba(255,255,255,0.12);

            color:white;

            cursor:pointer;

            font-size:20px;

            transition:0.3s ease;
        }

        .mobile-menu-btn:hover{
            background:rgba(255,255,255,0.2);
        }

        /* ===================================================
                        MAIN CONTENT
        =================================================== */

        .main-content{
            min-height:calc(100vh - 170px);
        }

        /* ===================================================
                           FOOTER
        =================================================== */

        .footer{
            margin-top:80px;

            background:
                linear-gradient(
                    135deg,
                    #0f172a,
                    #1e1b4b
                );

            color:white;

            text-align:center;

            padding:45px 20px;
        }

        .footer p{
            opacity:0.75;
            font-size:14px;
        }

        /* ===================================================
                        RESPONSIVE TABLET
        =================================================== */

        @media(max-width:1200px){

            .nav-links{
                justify-content:flex-start;
            }

        }

        /* ===================================================
                        RESPONSIVE MOBILE
        =================================================== */

        @media(max-width:900px){

            .nav-container{
                min-height:75px;
            }

            .mobile-menu-btn{
                display:flex;
                align-items:center;
                justify-content:center;
            }

            .nav-links{
                position:absolute;

                top:75px;
                left:0;
                right:0;

                display:flex;
                flex-direction:column;
                align-items:stretch;
                justify-content:flex-start;

                gap:10px;

                padding:20px;

                background:
                    linear-gradient(
                        135deg,
                        #0f172a,
                        #1e1b4b
                    );

                max-height:0;
                overflow:hidden;

                opacity:0;

                transition:0.4s ease;
            }

            .nav-links.mobile-open{
                max-height:1000px;
                opacity:1;
                overflow-y:auto;
            }

            .nav-links a{
                width:100%;
                justify-content:flex-start;

                padding:14px 18px;

                border-radius:16px;
            }

            .user-details{
                display:none;
            }

            .dropdown-menu{
                right:-20px;
                width:260px;
            }

        }

        @media(max-width:600px){

            .logo-text strong{
                font-size:22px;
            }

            .logo-icon{
                width:42px;
                height:42px;
            }

            .logo-icon i{
                font-size:20px;
            }

            .btn-login span{
                display:none;
            }

            .btn-login{
                width:46px;
                height:46px;
                padding:0;

                justify-content:center;
            }

        }

    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>

<!-- ===================================================
                        NAVBAR
=================================================== -->

<nav class="navbar">

    <div class="nav-container">

        <!-- LOGO -->
        <div class="logo">

            <a href="{{ path('app_home') }}">

                <div class="logo-icon">
                    <i class="fas fa-car-side"></i>
                </div>

                <div class="logo-text">
                    <strong>Wassalni</strong>
                    <span>TUNISIA</span>
                </div>

            </a>

        </div>

        <!-- NAVIGATION -->
        <div class="nav-links" id="navLinks">

            {% if app.user %}

                {% if is_granted('ROLE_PASSAGER') %}

                    <a href="{{ path('trajet_search') }}">
                        <i class="fas fa-search"></i>
                        Chercher un trajet
                    </a>

                    <a href="{{ path('mes_reservations') }}">
                        <i class="fas fa-calendar-check"></i>
                        Mes réservations
                    </a>

                    <a href="{{ path('reclamation_new') }}">
                        <i class="fas fa-file-circle-plus"></i>
                        Nouvelle réclamation
                    </a>

                    <a href="{{ path('reclamation_list') }}">
                        <i class="fas fa-list"></i>
                        Mes réclamations
                    </a>

                {% elseif is_granted('ROLE_CONDUCTEUR') %}

                    <a href="{{ path('conducteur_dashboard') }}">
                        <i class="fas fa-chart-line"></i>
                        Dashboard
                    </a>

                    <a href="{{ path('conducteur_mes_trajets') }}">
                        <i class="fas fa-route"></i>
                        Mes trajets
                    </a>

                    <a href="{{ path('trajet_new') }}">
                        <i class="fas fa-plus-circle"></i>
                        Proposer trajet
                    </a>

                    <a href="{{ path('vehicule_index') }}">
                        <i class="fas fa-car"></i>
                        Véhicules
                    </a>

                    <a href="{{ path('reclamation_new') }}">
                        <i class="fas fa-file-alt"></i>
                        Réclamation
                    </a>

                    <a href="{{ path('reclamation_list') }}">
                        <i class="fas fa-list-check"></i>
                        Réclamations
                    </a>

                    <a href="{{ path('conducteur_mes_avis') }}">
                        <i class="fas fa-star"></i>
                        Mes avis
                    </a>

                {% elseif is_granted('ROLE_ADMIN') %}

                    <a href="{{ path('admin_dashboard') }}">
                        <i class="fas fa-gauge-high"></i>
                        Dashboard
                    </a>

                    <a href="{{ path('admin_users') }}">
                        <i class="fas fa-users"></i>
                        Utilisateurs
                    </a>

                    <a href="{{ path('admin_trajets') }}">
                        <i class="fas fa-route"></i>
                        Trajets
                    </a>

                    <a href="{{ path('admin_reclamations') }}">
                        <i class="fas fa-file-alt"></i>
                        Réclamations
                    </a>

                {% endif %}

            {% else %}

                <a href="{{ path('trajet_search') }}">
                    <i class="fas fa-search"></i>
                    Chercher un trajet
                </a>

            {% endif %}

        </div>

        <!-- USER MENU -->
        <div class="user-menu">

            {% if app.user %}

                <div class="dropdown">

                    <div class="user-info">

                        <div class="user-avatar">
                            <i class="fas fa-user"></i>
                        </div>

                        <div class="user-details">

                            <strong>
                                {{ app.user.prenom }}
                                {{ app.user.nom[:1] }}.
                            </strong>

                            <span>
                                {% if is_granted('ROLE_ADMIN') %}
                                    Administrateur
                                {% elseif is_granted('ROLE_CONDUCTEUR') %}
                                    Conducteur
                                {% else %}
                                    Passager
                                {% endif %}
                            </span>

                        </div>

                        <i class="fas fa-chevron-down" style="color:white;font-size:12px;"></i>

                    </div>

                    <!-- DROPDOWN -->
                    <div class="dropdown-menu">

                        <div class="dropdown-header">

                            <h4>
                                {{ app.user.prenom }}
                                {{ app.user.nom }}
                            </h4>

                            <p>
                                {% if is_granted('ROLE_ADMIN') %}
                                    Administrateur
                                {% elseif is_granted('ROLE_CONDUCTEUR') %}
                                    Conducteur
                                {% else %}
                                    Passager
                                {% endif %}
                            </p>

                        </div>

                        <a href="{{ path('reclamation_list') }}">
                            <i class="fas fa-file-alt"></i>
                            Mes réclamations
                        </a>

                        <a href="{{ path('reclamation_new') }}">
                            <i class="fas fa-plus-circle"></i>
                            Nouvelle réclamation
                        </a>

                        <a href="{{ path('app_logout') }}"
                           class="logout"
                           onclick="return confirm('Déconnexion ?')">

                            <i class="fas fa-right-from-bracket"></i>
                            Déconnexion

                        </a>

                    </div>

                </div>

            {% else %}

                <a href="{{ path('app_login') }}" class="btn-login">

                    <i class="fas fa-sign-in-alt"></i>

                    <span>Connexion</span>

                </a>

            {% endif %}

        </div>

        <!-- MOBILE BUTTON -->
        <button class="mobile-menu-btn" id="mobileMenuBtn">

            <i class="fas fa-bars"></i>

        </button>

    </div>

</nav>

<!-- ===================================================
                      MAIN CONTENT
=================================================== -->

<main class="main-content">

    {% block body %}{% endblock %}

</main>

<!-- ===================================================
                         FOOTER
=================================================== -->

<footer class="footer">

    <p>
        © 2025 Wassalni.TN — Plateforme moderne de covoiturage en Tunisie
    </p>

</footer>

<!-- ===================================================
                       JAVASCRIPT
=================================================== -->

<script>

    const mobileBtn = document.getElementById('mobileMenuBtn');
    const navLinks  = document.getElementById('navLinks');

    mobileBtn.addEventListener('click', () => {

        navLinks.classList.toggle('mobile-open');

        if(navLinks.classList.contains('mobile-open')){
            mobileBtn.innerHTML =
                '<i class="fas fa-times"></i>';
        }else{
            mobileBtn.innerHTML =
                '<i class="fas fa-bars"></i>';
        }

    });

    // Fermer menu mobile au clic
    document.querySelectorAll('.nav-links a')
        .forEach(link => {

            link.addEventListener('click', () => {

                navLinks.classList.remove('mobile-open');

                mobileBtn.innerHTML =
                    '<i class="fas fa-bars"></i>';

            });

        });

</script>

{% block javascripts %}{% endblock %}

</body>
</html>