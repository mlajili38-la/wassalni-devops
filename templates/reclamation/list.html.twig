{% extends 'base.html.twig' %}

{% block title %}Mes réclamations - Wassalni{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .page-header {
        background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #4c1d95 100%);
        padding: 50px 0 70px 0;
        text-align: center;
        color: white;
    }
    
    .page-header h1 {
        font-size: 36px;
        font-weight: 800;
        margin-bottom: 10px;
    }
    
    .container-custom {
        max-width: 1200px;
        margin: -40px auto 0;
        padding: 0 20px;
    }
    
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 40px;
    }
    
    .stat-card {
        background: white;
        border-radius: 24px;
        padding: 25px;
        display: flex;
        align-items: center;
        gap: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        transition: all 0.3s;
    }
    
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.12);
    }
    
    .stat-icon {
        width: 55px;
        height: 55px;
        background: linear-gradient(135deg, #f3e8ff 0%, #e9d5ff 100%);
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .stat-icon i {
        font-size: 28px;
        color: #4c1d95;
    }
    
    .stat-info h3 {
        font-size: 28px;
        font-weight: 800;
        color: #1e293b;
        margin: 0;
    }
    
    .stat-info p {
        font-size: 13px;
        color: #64748b;
        margin: 5px 0 0;
    }
    
    .reclamation-card {
        background: white;
        border-radius: 24px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        transition: all 0.3s;
    }
    
    .reclamation-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }
    
    .reclamation-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        flex-wrap: wrap;
    }
    
    .reclamation-sujet {
        font-size: 18px;
        font-weight: 700;
        color: #1e293b;
    }
    
    .badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }
    
    .badge-warning {
        background: #fef3c7;
        color: #b45309;
    }
    
    .badge-success {
        background: #dcfce7;
        color: #15803d;
    }
    
    .badge-info {
        background: #e0f2fe;
        color: #0369a1;
    }
    
    .reclamation-meta {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 15px;
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }
    
    .reclamation-message {
        background: #f8fafc;
        padding: 15px;
        border-radius: 16px;
        margin-bottom: 15px;
        line-height: 1.5;
    }
    
    .btn-details {
        background: #f1f5f9;
        color: #4c1d95;
        padding: 8px 20px;
        border-radius: 30px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s;
    }
    
    .btn-details:hover {
        background: #4c1d95;
        color: white;
    }
    
    .empty-state {
        text-align: center;
        padding: 60px;
        background: white;
        border-radius: 24px;
    }
    
    .empty-state i {
        font-size: 64px;
        color: #cbd5e1;
        margin-bottom: 20px;
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #4c1d95 0%, #7c3aed 100%);
        color: white;
        padding: 12px 30px;
        border-radius: 40px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s;
    }
    
    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(76, 29, 149, 0.3);
    }
    
    @media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
        .reclamation-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-file-alt"></i> Mes réclamations</h1>
        <p>Consultez l'historique de vos réclamations</p>
    </div>
</div>

<div class="container-custom">
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-list"></i></div>
            <div class="stat-info">
                <h3>{{ stats.total }}</h3>
                <p>Total réclamations</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-clock"></i></div>
            <div class="stat-info">
                <h3>{{ stats.enAttente }}</h3>
                <p>En attente</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
            <div class="stat-info">
                <h3>{{ stats.traitees }}</h3>
                <p>Traitées</p>
            </div>
        </div>
    </div>
    
    {% if reclamations|length > 0 %}
        {% for reclamation in reclamations %}
            <div class="reclamation-card">
                <div class="reclamation-header">
                    <div class="reclamation-sujet">{{ reclamation.sujet }}</div>
                    <div>
                        {% if reclamation.statut == 'EN_ATTENTE' %}
                            <span class="badge badge-warning">En attente</span>
                        {% elseif reclamation.statut == 'TRAITEE' %}
                            <span class="badge badge-success">Traitée</span>
                        {% else %}
                            <span class="badge badge-info">En cours</span>
                        {% endif %}
                    </div>
                </div>
                
                <div class="reclamation-meta">
                    <span><i class="fas fa-calendar"></i> {{ reclamation.dateCreation|date('d/m/Y H:i') }}</span>
                    {% if reclamation.trajetConcerne %}
                        <span><i class="fas fa-route"></i> Trajet #{{ reclamation.trajetConcerne.id }}</span>
                    {% endif %}
                </div>
                
                <div class="reclamation-message">
                    <strong>Message :</strong><br>
                    {{ reclamation.message|slice(0, 150) }}{% if reclamation.message|length > 150 %}...{% endif %}
                </div>
                
                {% if reclamation.reponse %}
                    <div style="background: #dcfce7; padding: 12px; border-radius: 12px; margin-bottom: 15px;">
                        <strong><i class="fas fa-reply"></i> Réponse :</strong><br>
                        {{ reclamation.reponse }}
                    </div>
                {% endif %}
                
                <a href="{{ path('reclamation_show', {'id': reclamation.id}) }}" class="btn-details">
                    <i class="fas fa-eye"></i> Voir les détails
                </a>
            </div>
        {% endfor %}
    {% else %}
        <div class="empty-state">
            <i class="fas fa-file-alt"></i>
            <h3>Aucune réclamation</h3>
            <p>Vous n'avez pas encore envoyé de réclamation.</p>
            <a href="{{ path('reclamation_new') }}" class="btn-primary">
                <i class="fas fa-plus-circle"></i> Nouvelle réclamation
            </a>
        </div>
    {% endif %}
    
    <div style="text-align: center; margin-top: 30px;">
        <a href="{{ path('reclamation_new') }}" class="btn-primary">
            <i class="fas fa-plus-circle"></i> Nouvelle réclamation
        </a>
    </div>
</div>
{% endblock %}