{% extends 'base.html.twig' %}

{% block title %}Détail de la réclamation - Wassalni{% endblock %}

{% block stylesheets %}
{{ parent() }}

<style>
    *{
        margin:0;
        padding:0;
        box-sizing:border-box;
    }

    body{
        background:#f1f5f9;
        font-family:'Inter',sans-serif;
        color:#0f172a;
        overflow-x:hidden;
    }

    /* ================= HEADER ================= */

    .modern-header{
        position:relative;
        padding:70px 20px 120px;
        background:
            radial-gradient(circle at top left,#7c3aed 0%,transparent 35%),
            radial-gradient(circle at top right,#2563eb 0%,transparent 35%),
            linear-gradient(135deg,#0f172a 0%,#1e1b4b 50%,#312e81 100%);
        overflow:hidden;
    }

    .modern-header::before{
        content:'';
        position:absolute;
        width:500px;
        height:500px;
        background:rgba(255,255,255,0.05);
        border-radius:50%;
        top:-250px;
        right:-200px;
    }

    .modern-header::after{
        content:'';
        position:absolute;
        width:350px;
        height:350px;
        background:rgba(255,255,255,0.04);
        border-radius:50%;
        bottom:-180px;
        left:-120px;
    }

    .header-content{
        position:relative;
        z-index:2;
        max-width:1200px;
        margin:auto;
        text-align:center;
        color:white;
    }

    .header-content h1{
        font-size:48px;
        font-weight:800;
        margin-bottom:15px;
        line-height:1.2;
        word-break:break-word;
    }

    .header-content p{
        font-size:18px;
        opacity:0.92;
        max-width:700px;
        margin:auto;
        line-height:1.7;
    }

    /* ================= CONTAINER ================= */

    .page-container{
        max-width:1100px;
        margin:-70px auto 60px;
        padding:0 20px;
        position:relative;
        z-index:10;
    }

    /* ================= MAIN CARD ================= */

    .reclamation-card{
        background:white;
        border-radius:32px;
        overflow:hidden;
        box-shadow:
            0 10px 30px rgba(15,23,42,0.08),
            0 20px 60px rgba(15,23,42,0.12);
        border:1px solid rgba(255,255,255,0.4);
        backdrop-filter:blur(10px);
    }

    /* ================= CARD HEADER ================= */

    .card-top{
        padding:35px;
        background:linear-gradient(135deg,#4f46e5 0%,#7c3aed 100%);
        color:white;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:20px;
        flex-wrap:wrap;
    }

    .subject-wrapper{
        display:flex;
        align-items:center;
        gap:18px;
        min-width:0;
        flex:1;
    }

    .subject-icon{
        width:65px;
        height:65px;
        min-width:65px;
        border-radius:20px;
        background:rgba(255,255,255,0.15);
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:28px;
        backdrop-filter:blur(10px);
    }

    .subject-content{
        min-width:0;
        width:100%;
    }

    .subject-content h2{
        font-size:28px;
        font-weight:800;
        line-height:1.4;
        margin-bottom:8px;

        /* IMPORTANT POUR TEXTE LONG */
        overflow-wrap:anywhere;
        word-break:break-word;
    }

    .subject-content span{
        font-size:14px;
        opacity:0.9;
    }

    /* ================= STATUS BADGE ================= */

    .status-badge{
        padding:12px 22px;
        border-radius:999px;
        font-size:14px;
        font-weight:700;
        display:flex;
        align-items:center;
        gap:10px;
        white-space:nowrap;
        box-shadow:0 8px 20px rgba(0,0,0,0.15);
    }

    .status-pending{
        background:#fef3c7;
        color:#b45309;
    }

    .status-progress{
        background:#dbeafe;
        color:#1d4ed8;
    }

    .status-success{
        background:#dcfce7;
        color:#15803d;
    }

    /* ================= BODY ================= */

    .card-content{
        padding:40px;
    }

    .section{
        margin-bottom:40px;
    }

    .section:last-child{
        margin-bottom:0;
    }

    .section-title{
        display:flex;
        align-items:center;
        gap:14px;
        font-size:22px;
        font-weight:800;
        color:#0f172a;
        margin-bottom:25px;
    }

    .section-title .icon{
        width:50px;
        height:50px;
        border-radius:16px;
        background:linear-gradient(135deg,#ede9fe,#ddd6fe);
        color:#6d28d9;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:20px;
    }

    /* ================= INFO GRID ================= */

    .info-grid{
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
        gap:22px;
    }

    .info-card{
        background:#f8fafc;
        border:1px solid #e2e8f0;
        border-radius:24px;
        padding:24px;
        transition:0.3s ease;
        min-width:0;
    }

    .info-card:hover{
        transform:translateY(-5px);
        box-shadow:0 15px 30px rgba(0,0,0,0.08);
    }

    .info-label{
        display:flex;
        align-items:center;
        gap:10px;
        font-size:13px;
        font-weight:700;
        color:#64748b;
        margin-bottom:14px;
    }

    .info-value{
        font-size:17px;
        font-weight:700;
        color:#0f172a;
        line-height:1.6;

        /* CORRECTION TEXTE CACHE */
        overflow-wrap:anywhere;
        word-break:break-word;
    }

    /* ================= MESSAGE ================= */

    .message-container{
        border-radius:28px;
        padding:30px;
        position:relative;
        overflow:hidden;
    }

    .message-user{
        background:linear-gradient(135deg,#f8fafc 0%,#ffffff 100%);
        border:1px solid #e2e8f0;
    }

    .message-response{
        background:linear-gradient(135deg,#ecfdf5 0%,#f0fdf4 100%);
        border:1px solid #bbf7d0;
    }

    .message-label{
        display:flex;
        align-items:center;
        gap:12px;
        font-size:16px;
        font-weight:800;
        margin-bottom:20px;
    }

    .message-user .message-label{
        color:#4f46e5;
    }

    .message-response .message-label{
        color:#15803d;
    }

    .message-text{
        font-size:16px;
        line-height:1.9;
        color:#334155;

        /* IMPORTANT */
        overflow-wrap:anywhere;
        word-break:break-word;
        white-space:pre-wrap;
    }

    .response-date{
        margin-top:25px;
        padding-top:18px;
        border-top:1px dashed #86efac;
        font-size:13px;
        color:#15803d;
        font-weight:600;
    }

    /* ================= BUTTON ================= */

    .btn-wrapper{
        text-align:center;
        margin-top:50px;
    }

    .btn-modern{
        display:inline-flex;
        align-items:center;
        gap:14px;
        padding:16px 32px;
        border-radius:999px;
        text-decoration:none;
        background:linear-gradient(135deg,#0f172a,#1e293b);
        color:white;
        font-weight:700;
        transition:0.3s ease;
        box-shadow:0 10px 25px rgba(15,23,42,0.25);
    }

    .btn-modern:hover{
        transform:translateY(-4px);
        color:white;
        box-shadow:0 20px 35px rgba(15,23,42,0.3);
    }

    /* ================= RESPONSIVE ================= */

    @media(max-width:768px){

        .modern-header{
            padding:60px 20px 100px;
        }

        .header-content h1{
            font-size:34px;
        }

        .header-content p{
            font-size:15px;
        }

        .page-container{
            margin-top:-55px;
        }

        .card-top{
            flex-direction:column;
            align-items:flex-start;
            padding:25px;
        }

        .subject-wrapper{
            width:100%;
        }

        .subject-content h2{
            font-size:22px;
        }

        .card-content{
            padding:22px;
        }

        .section-title{
            font-size:18px;
        }

        .message-container{
            padding:22px;
        }

        .info-card{
            padding:20px;
        }

        .btn-modern{
            width:100%;
            justify-content:center;
        }
    }
</style>
{% endblock %}

{% block body %}

<div class="modern-header">
    <div class="header-content">
        <h1>
            <i class="fas fa-shield-alt"></i>
            Détail de la réclamation
        </h1>

        <p>
            Consultez toutes les informations relatives à votre réclamation,
            son état actuel ainsi que la réponse du support Wassalni.
        </p>
    </div>
</div>

<div class="page-container">

    <div class="reclamation-card">

        <!-- HEADER -->
        <div class="card-top">

            <div class="subject-wrapper">

                <div class="subject-icon">
                    <i class="fas fa-file-alt"></i>
                </div>

                <div class="subject-content">
                    <h2>{{ reclamation.sujet }}</h2>
                    <span>Réclamation #{{ reclamation.id }}</span>
                </div>

            </div>

            {% if reclamation.statut == 'EN_ATTENTE' %}
                <div class="status-badge status-pending">
                    <i class="fas fa-clock"></i>
                    En attente
                </div>

            {% elseif reclamation.statut == 'EN_COURS' %}
                <div class="status-badge status-progress">
                    <i class="fas fa-spinner fa-spin"></i>
                    En cours
                </div>

            {% else %}
                <div class="status-badge status-success">
                    <i class="fas fa-check-circle"></i>
                    Traitée
                </div>
            {% endif %}

        </div>

        <!-- BODY -->
        <div class="card-content">

            <!-- INFOS -->
            <div class="section">

                <div class="section-title">
                    <div class="icon">
                        <i class="fas fa-info"></i>
                    </div>

                    Informations générales
                </div>

                <div class="info-grid">

                    <div class="info-card">
                        <div class="info-label">
                            <i class="fas fa-calendar"></i>
                            Date de création
                        </div>

                        <div class="info-value">
                            {{ reclamation.dateCreation|date('d/m/Y H:i') }}
                        </div>
                    </div>

                    {% if reclamation.dateTraitement %}
                    <div class="info-card">
                        <div class="info-label">
                            <i class="fas fa-check-circle"></i>
                            Date de traitement
                        </div>

                        <div class="info-value">
                            {{ reclamation.dateTraitement|date('d/m/Y H:i') }}
                        </div>
                    </div>
                    {% endif %}

                    <div class="info-card">
                        <div class="info-label">
                            <i class="fas fa-route"></i>
                            Trajet concerné
                        </div>

                        <div class="info-value">
                            {% if reclamation.trajetConcerne %}
                                {{ reclamation.trajetConcerne.villeDepart }}
                                →
                                {{ reclamation.trajetConcerne.destination }}
                            {% else %}
                                Non spécifié
                            {% endif %}
                        </div>
                    </div>

                    {% if reclamation.utilisateurConcerne %}
                    <div class="info-card">
                        <div class="info-label">
                            <i class="fas fa-user"></i>
                            Utilisateur concerné
                        </div>

                        <div class="info-value">
                            {{ reclamation.utilisateurConcerne.prenom }}
                            {{ reclamation.utilisateurConcerne.nom }}
                        </div>
                    </div>
                    {% endif %}

                </div>

            </div>

            <!-- MESSAGE -->
            <div class="section">

                <div class="section-title">
                    <div class="icon">
                        <i class="fas fa-comment-dots"></i>
                    </div>

                    Votre message
                </div>

                <div class="message-container message-user">

                    <div class="message-label">
                        <i class="fas fa-envelope-open-text"></i>
                        Description détaillée
                    </div>

                    <div class="message-text">
                        {{ reclamation.message|nl2br }}
                    </div>

                </div>

            </div>

            <!-- RESPONSE -->
            {% if reclamation.reponse %}

            <div class="section">

                <div class="section-title">
                    <div class="icon">
                        <i class="fas fa-headset"></i>
                    </div>

                    Réponse du support
                </div>

                <div class="message-container message-response">

                    <div class="message-label">
                        <i class="fas fa-reply"></i>
                        Support Wassalni
                    </div>

                    <div class="message-text">
                        {{ reclamation.reponse|nl2br }}
                    </div>

                    {% if reclamation.dateTraitement %}
                    <div class="response-date">
                        <i class="fas fa-clock"></i>
                        Traité le
                        {{ reclamation.dateTraitement|date('d/m/Y à H:i') }}
                    </div>
                    {% endif %}

                </div>

            </div>

            {% endif %}

            <!-- BUTTON -->
            <div class="btn-wrapper">

                <a href="{{ path('reclamation_list') }}" class="btn-modern">
                    <i class="fas fa-arrow-left"></i>
                    Retour à mes réclamations
                </a>

            </div>

        </div>

    </div>

</div>

{% endblock %}