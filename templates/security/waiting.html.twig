{% extends 'base.html.twig' %}

{% block title %}Vérification par email - Wassalni{% endblock %}

{% block body %}
<div class="container" style="max-width: 600px; margin: 80px auto; padding: 0 20px;">
    <div id="waitingContainer" class="card" style="background: white; border-radius: 32px; padding: 40px; text-align: center; box-shadow: 0 20px 40px rgba(0,0,0,0.1);">
        
        <!-- CONTENU EN ATTENTE -->
        <div id="waitingContent">
            <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 25px;">
                <i class="fas fa-envelope" style="font-size: 36px; color: #d97706;"></i>
            </div>
            
            <h1 style="font-size: 28px; font-weight: 800; color: #1e293b; margin-bottom: 15px;">Vérifiez votre email</h1>
            
            <p style="color: #475569; margin-bottom: 20px;">
                Un email de confirmation vient d'être envoyé à votre adresse.
            </p>
            
            <div style="background: #f8fafc; border-radius: 16px; padding: 20px; margin-bottom: 25px;">
                <i class="fas fa-clock" style="color: #4c1d95; margin-right: 8px;"></i>
                <span style="color: #64748b;">Le lien est valable <strong>24 heures</strong>.</span>
            </div>
            
            <div id="loadingSpinner">
                <i class="fas fa-spinner fa-pulse" style="font-size: 24px; color: #4c1d95;"></i>
                <p style="color: #64748b; margin-top: 10px;">En attente de confirmation...</p>
            </div>
        </div>
        
        <!-- CONTENU CONNEXION (caché au début) -->
        <div id="loginContent" style="display: none;">
            <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 25px;">
                <i class="fas fa-check-circle" style="font-size: 36px; color: #15803d;"></i>
            </div>
            
            <h1 style="font-size: 28px; font-weight: 800; color: #1e293b; margin-bottom: 15px;">Compte activé !</h1>
            <p style="color: #475569; margin-bottom: 30px;">Vous pouvez maintenant vous connecter.</p>
            
            <a href="{{ path('app_login') }}" style="display: inline-block; background: linear-gradient(135deg, #4c1d95 0%, #7c3aed 100%); color: white; padding: 14px 40px; border-radius: 40px; text-decoration: none; font-weight: 600;">
                Aller à la page de connexion
            </a>
        </div>
    </div>
</div>

<script>
    let checkCount = 0;
    const maxChecks = 60;
    
    function checkVerificationStatus() {
        checkCount++;
        
        fetch('/check-verification-status')
            .then(response => response.json())
            .then(data => {
                if (data.verified) {
                    // Compte activé - afficher le formulaire de connexion
                    document.getElementById('waitingContent').style.display = 'none';
                    document.getElementById('loginContent').style.display = 'block';
                } else if (checkCount < maxChecks) {
                    setTimeout(checkVerificationStatus, 5000);
                } else {
                    document.getElementById('loadingSpinner').innerHTML = '<p style="color: #dc2626;">Délai dépassé. <a href="{{ path('app_login') }}" style="color: #4c1d95;">Aller à la connexion</a></p>';
                }
            })
            .catch(error => {
                console.error('Erreur:', error);
                if (checkCount < maxChecks) {
                    setTimeout(checkVerificationStatus, 10000);
                }
            });
    }
    
    setTimeout(checkVerificationStatus, 3000);
</script>

<style>
    .card {
        transition: all 0.5s ease;
    }
</style>
{% endblock %}