# Environnement Docker local/test uniquement. Copier vers .env.docker (ignore par Git)
# puis remplacer les valeurs "replace-..." avant de lancer Compose.
# Les mots de passe sont inseres dans une URL : utiliser uniquement lettres, chiffres, - et _.
APP_SECRET=replace-with-a-random-secret
APP_PORT=8080
APP_VERSION=local
MYSQL_DATABASE=wassalni
MYSQL_USER=wassalni
MYSQL_PASSWORD=replace-with-a-long-url-safe-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-url-safe-password
